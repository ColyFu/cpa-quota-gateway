[Unit]
Description=CPA Quota Gateway
Documentation=https://github.com/ColyFu/cpa-quota-gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/cpa-quota-gateway
EnvironmentFile=/etc/cpa-quota-gateway.env
ExecStart=/usr/bin/python3 /opt/cpa-quota-gateway/gateway.py
Restart=always
RestartSec=5s
TimeoutStopSec=30s
# Long Codex/SSE requests use one socket per client; leave headroom for bursts.
LimitNOFILE=524288
# One worker thread is used per client connection; do not impose a small
# systemd task ceiling on concurrent long-lived responses.
TasksMax=infinity
StateDirectory=cpa-quota-gateway
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
