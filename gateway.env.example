# Network. Keep LISTEN_HOST on loopback and publish only through Nginx.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8320
UPSTREAM_URL=http://127.0.0.1:8317
# Standby-only mode for a rolling restart; it disables background usage
# subscription so only the active gateway settles billing events.
GATEWAY_STANDBY=0

# A successful attempt can run without a timeout. Failed attempts use a bounded
# shared budget, exponential backoff, and a cooldown across client reconnects.
UPSTREAM_HEADER_RETRY_ATTEMPTS=2
UPSTREAM_HEADER_RETRY_BUDGET_SECONDS=0
UPSTREAM_HEADER_ATTEMPT_TIMEOUT_SECONDS=0
UPSTREAM_HEADER_RETRY_BACKOFF_SECONDS=2
UPSTREAM_RETRY_MAX_BACKOFF_SECONDS=30
UPSTREAM_FAILURE_COOLDOWN_SECONDS=60
UPSTREAM_STREAM_TIMEOUT_SECONDS=0
UPSTREAM_MAX_ATTEMPTS_PER_REQUEST=3
UPSTREAM_REQUEST_FINGERPRINT_TTL_SECONDS=1200

# Requests at or above this size use the same header wait and bounded retry
# policy. A transport failure before the first response byte is retried; callers
# should provide the same client request id when their API supports idempotency.
UPSTREAM_LARGE_REQUEST_BYTES=2097152
UPSTREAM_LARGE_REQUEST_HEADER_TIMEOUT_SECONDS=0
UPSTREAM_LARGE_REQUEST_RETRY_ATTEMPTS=2
UPSTREAM_LARGE_REQUEST_RETRY_BUDGET_SECONDS=0

# Keep the paid Codex API disabled until every observed Pro OAuth request has
# failed continuously for this window. Any OAuth success closes the fallback.
CPA_CONFIG_PATH=/home/ubuntu/cpa-stack/cli-proxy-api/config.yaml
PRO_FAILOVER_ENABLED=true
PRO_FAILOVER_WINDOW_SECONDS=600

# CPA Usage Keeper admin API. The gateway periodically reads API keys, aliases,
# and model prices through this API, then retains a local cached snapshot.
KEEPER_URL=http://127.0.0.1:8318
KEEPER_LOGIN_PASSWORD=replace-with-keeper-login-password
# Refresh Keeper API keys and model prices while the gateway is running.
KEEPER_SYNC_INTERVAL_SECONDS=60
# Replay durable Keeper usage events after Redis disconnects/restarts.
KEEPER_USAGE_SYNC_INTERVAL_SECONDS=30
KEEPER_USAGE_BATCH_SIZE=250

# CLIProxyAPI management key is used only for the authenticated usage pub/sub.
CPA_MANAGEMENT_KEY=replace-with-cli-proxy-api-management-key

# Durable quota ledger. This path matches the provided systemd StateDirectory.
QUOTA_DB=/var/lib/cpa-quota-gateway/quota.db
BILLING_TIMEZONE=Asia/Shanghai

# Defaults applied when Keeper adds a new API key. The initial cycle is a
# calendar month; it can be changed to a fixed 1-3650 day cycle in the UI.
DEFAULT_BUDGET_USD=1000
# Zero means wait for capacity instead of returning an artificial 429.
DEFAULT_RPM=0
DEFAULT_CONCURRENCY=0
# Initial total executing limit; later admin UI settings persist in SQLite.
# Eligible superusers have priority; each priority class preserves FIFO order.
GLOBAL_CONCURRENCY=10
# Zero disables the gateway request-body ceiling.
MAX_REQUEST_BODY_BYTES=0

# Conservative pre-authorization before actual token usage is known.
RESERVATION_USD=2
# Zero keeps a live request reservation until its usage event settles it;
# this avoids expiring a legitimate long-running Codex turn mid-flight.
RESERVATION_TTL_SECONDS=0
DEFAULT_MAX_OUTPUT_TOKENS=128000

# Generate with: openssl rand -hex 32
QUOTA_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional, used only by --backfill-keeper-month for a one-time history import.
# KEEPER_DB=/path/to/cpa-usage-keeper/data/app.db

# Optional bounded recovery for transient upstream 500/502/503/504 responses.
# Start this window after the first transient failure, preserving healthy long turns.
# To use time instead of attempt ceilings, set both retry-attempt settings and
# UPSTREAM_MAX_ATTEMPTS_PER_REQUEST to 0; a negative retry setting disables retries.
# Production: recovery=600, initial backoff=15, max backoff=60.
UPSTREAM_TRANSIENT_RECOVERY_SECONDS=0
