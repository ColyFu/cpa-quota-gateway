# Network. Keep LISTEN_HOST on loopback and publish only through Nginx.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8320
UPSTREAM_URL=http://127.0.0.1:8317

# CPA Usage Keeper admin API. The gateway periodically reads API keys, aliases,
# and model prices through this API, then retains a local cached snapshot.
KEEPER_URL=http://127.0.0.1:8318
KEEPER_LOGIN_PASSWORD=replace-with-keeper-login-password

# CLIProxyAPI management key is used only for the authenticated usage pub/sub.
CPA_MANAGEMENT_KEY=replace-with-cli-proxy-api-management-key

# Durable quota ledger. This path matches the provided systemd StateDirectory.
QUOTA_DB=/var/lib/cpa-quota-gateway/quota.db
BILLING_TIMEZONE=Asia/Shanghai

# Defaults applied when Keeper adds a new API key.
DEFAULT_MONTHLY_BUDGET_USD=1000
DEFAULT_RPM=120
DEFAULT_CONCURRENCY=20

# Conservative pre-authorization before actual token usage is known.
RESERVATION_USD=2
RESERVATION_TTL_SECONDS=3600
DEFAULT_MAX_OUTPUT_TOKENS=128000

# Generate with: openssl rand -hex 32
QUOTA_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional, used only by --backfill-keeper-month for a one-time history import.
# KEEPER_DB=/path/to/cpa-usage-keeper/data/app.db
