+func TestRequestLoggingMiddlewareSkipsTrustedGatewayTranscripts(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	dir := t.TempDir()
+	logger := logging.NewFileRequestLogger(true, dir, dir, 5)
+	router := gin.New()
+	router.Use(func(c *gin.Context) { c.Set("quotaGatewayPromptOnly", true); c.Next() })
+	router.Use(RequestLoggingMiddleware(logger))
+	body := strings.Repeat("private system and assistant transcript", 5000)
+	router.POST("/v1/responses", func(c *gin.Context) {
+		got, err := io.ReadAll(c.Request.Body)
+		if err != nil || string(got) != body {
+			t.Fatal("forwarded body changed")
+		}
+		c.JSON(500, gin.H{"error": "synthetic failure"})
+	})
+	request := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(body))
+	request.Header.Set("Content-Type", "application/json")
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, request)
+	if response.Code != 500 {
+		t.Fatal("response changed")
+	}
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) != 0 {
+		t.Fatal("trusted Gateway request created transcript files")
+	}
+}
