@@ -0,0 +1,122 @@
+package handlers
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"golang.org/x/net/context"
+)
+
+func TestQuotaGatewayRequestRecordingUsesAuthenticatedID(t *testing.T) {
+	t.Setenv("QUOTA_ROUTING_TOKEN", "secret")
+	const id = "12345678-1234-4234-8234-123456789012"
+	for _, tc := range []struct {
+		token, id string
+		status    int
+	}{
+		{"secret", id, 200}, {"", id, 403}, {"wrong", id, 403}, {"secret", "not-a-uuid", 400},
+	} {
+		router := gin.New()
+		router.Use(logging.GinLogrusLogger(), QuotaGatewayRouting())
+		router.POST("/v1/responses", func(c *gin.Context) {
+			if logging.GetGinRequestID(c) != id || logging.GetRequestID(c.Request.Context()) != id {
+				t.Error("request ID did not reach execution context")
+			}
+			if c.GetHeader("X-Quota-Request-ID") != "" || c.GetHeader("X-Quota-Routing-Token") != "" {
+				t.Error("private headers leaked downstream")
+			}
+			c.Status(200)
+		})
+		req := httptest.NewRequest("POST", "/v1/responses", nil)
+		req.Header.Set("X-Quota-Request-ID", tc.id)
+		req.Header.Set("X-Quota-Routing-Token", tc.token)
+		response := httptest.NewRecorder()
+		router.ServeHTTP(response, req)
+		if response.Code != tc.status {
+			t.Fatalf("status=%d, want %d", response.Code, tc.status)
+		}
+	}
+}
+
+func TestQuotaGatewayAuthenticatedPinReachesExecutorMetadata(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv("QUOTA_ROUTING_TOKEN", "server-secret")
+	for _, tc := range []struct {
+		name, token, id string
+		status          int
+	}{
+		{"normal", "", "", 200}, {"valid", "server-secret", "account-a", 200},
+		{"missing token", "", "account-a", 403}, {"forged token", "other", "account-a", 403},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			router := gin.New()
+			router.Use(QuotaGatewayRouting())
+			router.POST("/v1/responses", func(c *gin.Context) {
+				handler := &BaseAPIHandler{Cfg: &config.SDKConfig{}}
+				ctx, cancel := handler.GetContextWithCancel(nil, c, context.Background())
+				defer cancel()
+				got, _ := requestExecutionMetadata(ctx)[coreexecutor.PinnedAuthMetadataKey].(string)
+				if got != tc.id {
+					t.Errorf("pin = %q, want %q", got, tc.id)
+				}
+				if c.GetHeader("X-Quota-Auth-ID") != "" || c.GetHeader("X-Quota-Routing-Token") != "" {
+					t.Error("routing credentials leaked downstream")
+				}
+				c.Status(200)
+			})
+			req := httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+			req.Header.Set("X-Quota-Auth-ID", tc.id)
+			req.Header.Set("X-Quota-Routing-Token", tc.token)
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, req)
+			if response.Code != tc.status {
+				t.Fatalf("status = %d, want %d", response.Code, tc.status)
+			}
+		})
+	}
+}
+
+func TestQuotaGatewayDisabledRejectsPins(t *testing.T) {
+	t.Setenv("QUOTA_ROUTING_TOKEN", "")
+	router := gin.New()
+	router.Use(QuotaGatewayRouting())
+	router.GET("/v1/models", func(c *gin.Context) { c.Status(200) })
+	req := httptest.NewRequest("GET", "/v1/models", nil)
+	req.Header.Set("X-Quota-Auth-ID", "a")
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, req)
+	if response.Code != 403 {
+		t.Fatalf("status=%d", response.Code)
+	}
+}
+
+func TestQuotaGatewayCapabilityRequiresSecretAndDoesNotExposeIt(t *testing.T) {
+	t.Setenv("QUOTA_ROUTING_TOKEN", "secret")
+	router := gin.New()
+	router.Use(QuotaGatewayRouting())
+	router.Use(func(c *gin.Context) {
+		if c.GetHeader("X-Quota-Routing-Token") != "" {
+			t.Error("token reached later middleware")
+		}
+		c.Next()
+	})
+	router.GET("/quota-gateway/capabilities", QuotaGatewayCapabilities)
+	for _, token := range []string{"", "wrong", "secret"} {
+		req := httptest.NewRequest("GET", "/quota-gateway/capabilities", nil)
+		req.Header.Set("X-Quota-Routing-Token", token)
+		response := httptest.NewRecorder()
+		router.ServeHTTP(response, req)
+		expected := 403
+		if token == "secret" {
+			expected = 200
+		}
+		if response.Code != expected {
+			t.Errorf("status=%d, want %d", response.Code, expected)
+		}
+	}
+}
