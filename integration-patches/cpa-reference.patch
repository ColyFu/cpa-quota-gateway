diff --git a/sdk/api/handlers/quota_gateway.go b/sdk/api/handlers/quota_gateway.go
new file mode 100644
index 0000000..9feb21c
--- /dev/null
+++ b/sdk/api/handlers/quota_gateway.go
@@ -0,0 +1,41 @@
+package handlers
+
+import (
+	"crypto/subtle"
+	"net/http"
+	"os"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+// QuotaGatewayRouting authenticates the optional credential pin before execution.
+// The normal API-key middleware still authenticates the request independently.
+func QuotaGatewayRouting() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		id := strings.TrimSpace(c.GetHeader("X-Quota-Auth-ID"))
+		token := c.GetHeader("X-Quota-Routing-Token")
+		c.Request.Header.Del("X-Quota-Auth-ID")
+		c.Request.Header.Del("X-Quota-Routing-Token")
+		expected := os.Getenv("QUOTA_ROUTING_TOKEN")
+		verified := expected != "" && subtle.ConstantTimeCompare([]byte(token), []byte(expected)) == 1
+		c.Set("quotaGatewayAuthenticated", verified)
+		if id != "" {
+			if !verified {
+				c.AbortWithStatusJSON(http.StatusForbidden, gin.H{"error": "invalid quota routing credential"})
+				return
+			}
+			c.Set("quotaGatewayAuthID", id)
+		}
+		c.Next()
+	}
+}
+
+// QuotaGatewayCapabilities lets the gateway fail closed against an unpatched CPA.
+func QuotaGatewayCapabilities(c *gin.Context) {
+	if !c.GetBool("quotaGatewayAuthenticated") {
+		c.AbortWithStatus(http.StatusForbidden)
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"credential_pinning": true, "version": 1})
+}
