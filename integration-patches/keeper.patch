diff --git a/web/src/components/usage/analysis/ModelOutputSpeedCard.tsx b/web/src/components/usage/analysis/ModelOutputSpeedCard.tsx
new file mode 100644
index 0000000..e865245
--- /dev/null
+++ b/web/src/components/usage/analysis/ModelOutputSpeedCard.tsx
@@ -0,0 +1,72 @@
+import { useEffect, useState } from 'react';
+import { ApiError, fetchAnalysisOutputSpeed } from '@/lib/api';
+import type { AnalysisOutputSpeed, ModelOutputSpeed, UsageRangeRequest } from '@/lib/types';
+import styles from './ModelOutputSpeedCard.module.scss';
+
+const rate = (value: number | null) => value === null ? '—' : value.toLocaleString('zh-CN', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
+const xAt = (index: number, count: number) => count <= 1 ? 150 : 8 + index / (count - 1) * 284;
+const yAt = (value: number, max: number) => 48 - value / max * 40;
+export function speedCurvePath(points: (number | null)[], max: number) {
+  let connected = false;
+  return points.map((point, index) => {
+    if (point === null) { connected = false; return ''; }
+    const command = connected ? 'L' : 'M'; connected = true;
+    return `${command}${xAt(index, points.length).toFixed(2)},${yAt(point, max).toFixed(2)}`;
+  }).join(' ');
+}
+function bucketLabel(bucket: string, timezone: string, daily: boolean) {
+  const date = new Date(bucket);
+  try { return date.toLocaleString('zh-CN', { timeZone: timezone === 'Local' ? undefined : timezone, month: '2-digit', day: '2-digit', ...(daily ? {} : { hour: '2-digit', minute: '2-digit', hour12: false }) }); }
+  catch { return date.toLocaleString('zh-CN'); }
+}
+function SpeedRow({ model, data, max }: { model: ModelOutputSpeed; data: AnalysisOutputSpeed; max: number }) {
+  const [active, setActive] = useState<number | null>(null);
+  const label = active === null ? '' : `${bucketLabel(data.buckets[active], data.timezone, data.granularity === 'daily')} · ${model.points[active] === null ? '无有效样本' : `${rate(model.points[active])} token/s · ${model.samples[active]} 次请求`}`;
+  return <tr className={styles.modelRow}>
+    <th scope="row"><strong title={model.model}>{model.model}</strong><small>{model.sample_count.toLocaleString()} 次有效请求{model.excluded_count > 0 ? ` · ${model.excluded_count.toLocaleString()} 次未计入` : ''}</small></th>
+    <td className={styles.curveCell}>
+      <svg viewBox="0 0 300 56" preserveAspectRatio="none" role="img" aria-label={`${model.model} 输出速度曲线，平均 ${rate(model.average_tps)} token/s；方向键查看时段`} tabIndex={0}
+        onMouseMove={event => { const box = event.currentTarget.getBoundingClientRect(); const x = (event.clientX - box.left) / box.width * 300; setActive(Math.max(0, Math.min(model.points.length - 1, Math.round((x - 8) / 284 * (model.points.length - 1))))); }}
+        onMouseLeave={() => setActive(null)} onFocus={() => setActive(model.points.findIndex(point => point !== null) >= 0 ? model.points.findIndex(point => point !== null) : 0)} onBlur={() => setActive(null)}
+        onKeyDown={event => { if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); setActive(Math.min(model.points.length - 1, Math.max(0, (active ?? 0) + (event.key === 'ArrowRight' ? 1 : -1)))); } else if (event.key === 'Escape') setActive(null); }}>
+        <path d="M8,48 H292 M8,28 H292" className={styles.grid} />
+        {model.average_tps !== null && <path d={`M8,${yAt(model.average_tps, max)} H292`} className={styles.averageLine} />}
+        <path d={speedCurvePath(model.points, max)} className={styles.curve} />
+        {model.points.map((point, index) => point === null ? null : <circle key={index} cx={xAt(index, model.points.length)} cy={yAt(point, max)} r={model.points.length > 48 ? 1.5 : 2.5} className={styles.dot} />)}
+        {active !== null && <path d={`M${xAt(active, model.points.length)},6 V50`} className={styles.cursor} />}
+      </svg>
+      {active !== null && <span className={styles.tooltip} role="status">{label}</span>}
+    </td>
+    <td className={styles.mean}><strong>{rate(model.average_tps)}</strong><small>{model.average_tps === null ? '无有效计时' : 'token/s'}</small></td>
+  </tr>;
+}
+export function ModelOutputSpeedCard({ request, apiKeyId, refreshKey = 0, onAuthRequired }: { request?: UsageRangeRequest; apiKeyId?: string; refreshKey?: number; onAuthRequired?: () => void }) {
+  const [result, setResult] = useState<{ key: string; data: AnalysisOutputSpeed | null; error: string }>({ key: '', data: null, error: '' });
+  const [retry, setRetry] = useState(0);
+  const query = JSON.stringify(request);
+  const requestKey = JSON.stringify([query, apiKeyId, refreshKey, retry]);
+  const current = Boolean(query) && result.key === requestKey;
+  const data = current ? result.data : null;
+  const error = current ? result.error : '';
+  const loading = Boolean(query) && !current;
+  useEffect(() => {
+    if (!query) return;
+    const controller = new AbortController();
+    void fetchAnalysisOutputSpeed(JSON.parse(query) as UsageRangeRequest, controller.signal, apiKeyId)
+      .then(response => { if (!controller.signal.aborted) setResult({ key: requestKey, data: response, error: '' }); })
+      .catch((e: Error) => { if (!controller.signal.aborted) { if (e instanceof ApiError && e.status === 401) onAuthRequired?.(); setResult({ key: requestKey, data: null, error: e.message }); } });
+    return () => controller.abort();
+  }, [query, apiKeyId, requestKey, onAuthRequired]);
+  let maximum = 0;
+  for (const model of data?.models ?? []) for (const point of model.points) if (point !== null) maximum = Math.max(maximum, point);
+  const max = Math.max(10, Math.ceil(maximum / 10) * 10);
+  return <section className={styles.card} aria-label="模型输出速度">
+    <div className={styles.header}><h3>模型输出速度</h3><p>从首字开始计时，随页面的 API Key 和范围筛选。</p></div>
+    {loading ? <div className={styles.empty} role="status">正在统计输出速度…</div> : error ? <div className={styles.empty} role="alert"><span>{error}</span><button onClick={() => setRetry(value => value + 1)}>重试</button></div> : !data?.models.length ? <div className={styles.empty}>所选范围暂无请求记录</div> : <>
+      <div className={styles.scale}>曲线共用纵轴：0–{max.toLocaleString()} token/s · 虚线为该模型平均速度</div>
+      <div className={styles.tableScroll}><table><thead><tr><th>模型</th><th>速度曲线（{data.granularity === 'daily' ? '按天' : '按小时'}）</th><th className={styles.mean}>平均速度</th></tr></thead><tbody>{data.models.map(model => <SpeedRow key={model.model} model={model} data={data} max={max} />)}</tbody></table></div>
+      {data.buckets.length > 0 && <div className={styles.range}><span>{bucketLabel(data.buckets[0], data.timezone, data.granularity === 'daily')}</span><span>{bucketLabel(data.buckets[data.buckets.length - 1], data.timezone, data.granularity === 'daily')}</span></div>}
+    </>}
+    <p className={styles.note}>平均速度 = 有效请求总输出 Token ÷ 总输出耗时；输出耗时 = 总耗时 − 首字等待。Token 含推理，基于已保留的请求记录；失败、无输出或计时无效的请求不计入，曲线空档表示无有效样本。</p>
+  </section>;
+}
