+  }
+  it('renders 10 columns and copies the full key without exposing it in markup', async () => {
+    await render();
+    expect(container.querySelectorAll('thead th')).toHaveLength(10);expect(container.querySelectorAll('.gw-user-row')).toHaveLength(2);
+    expect(container.querySelector('.gw-key-copy code')?.textContent).toBe('123450');
+    expect(container.innerHTML).not.toContain(users[0].apiKey);
+    await click(container.querySelector('.gw-key-copy'));expect(copyApiKeyToClipboard).toHaveBeenCalledWith(users[0].apiKey);
+    expect(container.querySelector('select[aria-label="优先认证账号"]')?.textContent).toContain('主订阅');
