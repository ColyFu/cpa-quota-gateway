+
+func TestOutputSpeedResolvesAPIKeyScope(t *testing.T) {
+	db := openUsageServiceTestDatabase(t)
+	key := entities.CPAAPIKey{APIKey: "a"}
+	if err := db.Create(&key).Error; err != nil {
