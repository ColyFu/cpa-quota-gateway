+import { describe, expect, it } from 'vitest';
+import type { UsageIdentity } from '@/lib/types';
+import { findAccountIdentity } from './useAccountAliases';
+const file={id:'primary.json',name:'primary.json',provider:'codex',available:true};
+const identity={id:'keeper-id',file_name:'primary.json',auth_type:1,is_deleted:false,alias:'主账号'} as UsageIdentity;
+describe('authentication file alias mapping',()=>{
+  it('uses the live auth-file identity and excludes deleted files and API providers',()=>{
+    expect(findAccountIdentity(file,[{...identity,id:'old',is_deleted:true},{...identity,id:'api',auth_type:2},identity])).toBe(identity);
+  });
+  it('does not rename an ambiguous or unmatched identity',()=>{
+    expect(findAccountIdentity(file,[identity,{...identity,id:'other'}])).toBeUndefined();
+    expect(findAccountIdentity({...file,id:'missing',name:'missing'},[identity])).toBeUndefined();
+  });
+});
diff --git a/web/src/features/gateway/useAccountAliases.ts b/web/src/features/gateway/useAccountAliases.ts
new file mode 100644
index 0000000..d4bdab5
--- /dev/null
+++ b/web/src/features/gateway/useAccountAliases.ts
@@ -0,0 +1,32 @@
+import { useCallback, useEffect, useState } from 'react';
+import { fetchUsageIdentities } from '@/lib/api';
+import type { UsageIdentity } from '@/lib/types';
+import { gatewayAPI } from './api';
+
+export interface DiscoveredAccount { id: string; name: string; provider: string; available: boolean }
+export function findAccountIdentity(account: DiscoveredAccount, identities: UsageIdentity[]) {
+  const matches = identities.filter(identity => identity.auth_type === 1 && !identity.is_deleted &&
+    [identity.file_name, identity.file_path].some(name => name && (name === account.id || name === account.name)));
+  return matches.length === 1 ? matches[0] : undefined;
+}
+export function useAccountAliases() {
+  const [accounts, setAccounts] = useState<DiscoveredAccount[]>([]);
+  const [identities, setIdentities] = useState<UsageIdentity[]>([]);
+  const [error, setError] = useState('');
+  const [revision, setRevision] = useState(0);
+  const reload = useCallback(() => setRevision(value => value + 1), []);
+  useEffect(() => {
+    window.addEventListener('quota-account-alias-saved', reload);
+    return () => window.removeEventListener('quota-account-alias-saved', reload);
+  }, [reload]);
+  useEffect(() => {
+    const controller = new AbortController();
+    void Promise.all([gatewayAPI<{ accounts: DiscoveredAccount[] }>('accounts', 'GET', undefined, controller.signal), fetchUsageIdentities(controller.signal)])
+      .then(([files, data]) => { setAccounts(files.accounts); setIdentities(data.identities); setError(''); })
+      .catch(e => { if (!controller.signal.aborted) setError((e as Error).message); });
+    return () => controller.abort();
+  }, [revision]);
+  const byAccount = Object.fromEntries(accounts.map(account => [account.id, findAccountIdentity(account, identities)]));
+  const names = Object.fromEntries(accounts.map(account => [account.id, byAccount[account.id]?.alias?.trim() || account.name]));
+  return { accounts, byAccount, names, error, reload };
+}
