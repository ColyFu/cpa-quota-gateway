+import { useEffect, useState } from 'react';
+import type { UsageIdentity } from '@/lib/types';
+import { gatewayAPI, type Account, type Routing } from './api';
+import { useAccountAliases } from './useAccountAliases';
+import './gateway.css';
+
+function AccountAlias({ identity, onSave, onNotice }: { identity?: UsageIdentity; onSave: (id: string, alias: string) => Promise<void>; onNotice: (message: string) => void }) {
+  const [alias, setAlias] = useState(identity?.alias ?? '');
+  const [busy, setBusy] = useState(false);
+  const save = async () => {
+    if (!identity) return;
+    setBusy(true);
+    try { await onSave(identity.id, alias.trim()); onNotice('认证账号别名已保存，优先认证账号列表同步使用此别名'); }
+    catch (e) { onNotice(`别名保存失败：${(e as Error).message}`); } finally { setBusy(false); }
+  };
+  return <div className="gw-account-alias"><input aria-label="认证账号别名" placeholder={identity ? '填写便于区分的别名' : '等待认证文件同步'} maxLength={50} disabled={!identity || busy} value={alias} onChange={e => setAlias(e.target.value)} onKeyDown={e => { if (e.key === 'Enter') { e.preventDefault(); void save(); } }} /><button type="button" disabled={!identity || busy || alias.trim() === (identity.alias ?? '').trim()} onClick={() => void save()}>{busy ? '保存中…' : '保存别名'}</button></div>;
+}
+
+export function AccountRouting({ onSaveAlias }: { onSaveAlias: (id: string, alias: string) => Promise<void> }) {
+  const [config, setConfig] = useState<Routing | null>(null);
+  const [limit, setLimit] = useState(0);
+  const aliases = useAccountAliases();
+  const [message, setMessage] = useState('');
+  const [busy, setBusy] = useState(false);
+  useEffect(() => {
+    const controller = new AbortController();
+    void Promise.all([gatewayAPI<Routing>('routing', 'GET', undefined, controller.signal), gatewayAPI<{ limit: number }>('concurrency', 'GET', undefined, controller.signal)]).then(([routing, state]) => { setConfig(routing); setLimit(state.limit); }).catch(e => { if (!controller.signal.aborted) setMessage(e.message); });
+    return () => controller.abort();
+  }, []);
+  const save = async (event: React.FormEvent) => {
+    event.preventDefault(); if (!config) return; setBusy(true); setMessage('');
+    try { const saved = await gatewayAPI<Routing>('routing', 'PUT', config); setConfig(saved); setMessage('账号调度设置已保存'); }
+    catch (e) { setMessage(e instanceof Error ? e.message : '保存失败'); } finally { setBusy(false); }
+  };
+  const accounts = [...aliases.accounts, ...(config?.accounts.filter(account => !aliases.accounts.some(file => file.id === account.id)).map(account => ({ ...account, provider: '', available: false })) ?? [])];
+  const changeAccount = (id: string, update: Partial<Account>) => {
+    if (!config) return;
+    const previous = config.accounts.find(account => account.id === id);
+    const source = accounts.find(account => account.id === id);
+    if (!source) return;
+    const next = { id, name: source.name, enabled: false, concurrency: 1, models: [], ...previous, ...update };
+    setConfig({ ...config, accounts: previous ? config.accounts.map(account => account.id === id ? next : account) : [...config.accounts, next] });
+  };
+  return <section className="gw-card"><div className="gw-heading"><div><h2>并发与账号调度</h2><p>为认证文件设置别名后，用户的优先认证账号列表也会显示该别名。</p></div></div>
+    {message && <p role="status" className="gw-message">{message}</p>}
+    {aliases.error && <p role="alert">认证账号读取失败：{aliases.error} <button onClick={aliases.reload}>重试</button></p>}
+    <form className="gw-inline" onSubmit={async e => { e.preventDefault(); setBusy(true); try { await gatewayAPI('concurrency', 'PUT', { global_limit: limit }); setMessage('总并发已保存'); } catch(e) { setMessage((e as Error).message); } finally { setBusy(false); } }}>
+      <label>总并发上限<input type="number" min="0" step="1" required value={limit} onChange={e => setLimit(Number(e.target.value))} /></label><button disabled={busy || !config}>保存总并发</button><span>0 表示不限制</span>
+    </form>
+    {config && <form onSubmit={save}>
+      <div className="gw-inline">
+        <label className="gw-check"><input type="checkbox" checked={config.enabled} onChange={e => setConfig({ ...config, enabled: e.target.checked })} />启用账号调度</label>
+        <label>会话保持（小时）<input type="number" min="0.1" max="720" step="0.1" required value={config.session_ttl_hours} onChange={e => setConfig({ ...config, session_ttl_hours: Number(e.target.value) })} /></label>
+        <label>账号溢出阈值（排队数）<input type="number" min="0" step="1" required value={config.overflow_threshold} onChange={e => setConfig({ ...config, overflow_threshold: Number(e.target.value) })} /></label>
+      </div>
+      <p className="gw-help">同一用户的同一 session 从最近一次请求起保持绑定。新会话优先使用用户指定账号；账号满载且排队达到阈值时，才分配到有空位的账号。已有会话保持原账号，账号不可用时重新选择。</p>
+      <div className="gw-table-wrap"><table className="gw-table gw-accounts-table"><thead><tr><th scope="col">认证文件</th><th scope="col">别名</th><th scope="col">参与调度</th><th scope="col">账号并发</th><th scope="col">模型限制（留空由 CPA 判断）</th></tr></thead><tbody>{accounts.map(file => {
+        const account = config.accounts.find(a => a.id === file.id);
+        const identity = aliases.byAccount[file.id];
+        const name = aliases.names[file.id] || file.name;
+        return <tr key={file.id}>
+          <td><strong>{name}</strong><small>{file.name}</small>{!file.available && <small>当前不可用</small>}</td>
+          <td><AccountAlias key={`${identity?.id}-${identity?.alias ?? ''}`} identity={identity} onSave={onSaveAlias} onNotice={setMessage} /></td>
+          <td><input aria-label={`${name} 参与调度`} type="checkbox" checked={account?.enabled ?? false} disabled={busy} onChange={e => changeAccount(file.id, { enabled: e.target.checked })} /></td>
+          <td><input aria-label={`${name} 账号并发`} type="number" min="1" step="1" required value={account?.concurrency ?? 1} disabled={busy || !account} onChange={e => changeAccount(file.id, { concurrency: Number(e.target.value) })} /></td>
+          <td><input aria-label={`${name} 模型限制`} disabled={busy || !account} defaultValue={account?.models.join(', ') ?? ''} onBlur={e => changeAccount(file.id, { models: e.target.value.split(',').map(x => x.trim()).filter(Boolean) })} /></td>
+        </tr>;
+      })}{accounts.length === 0 && <tr><td colSpan={5} className="gw-empty">{aliases.error ? '请重试加载认证文件' : '暂无已同步的认证文件'}</td></tr>}</tbody></table></div>
+      <div className="gw-inline"><button disabled={busy}>保存账号调度</button><button type="button" disabled={busy} onClick={aliases.reload}>刷新认证文件</button><span className="gw-help">别名单独保存；参与调度和并发修改后请保存账号调度。</span></div>
+    </form>}
+  </section>;
+}
