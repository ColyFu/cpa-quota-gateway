+import { useState } from 'react';
+import { RankingPage } from '@/features/ranking/RankingPage';
+import { useLocalRankingData } from '@/features/ranking/hooks/useLocalRankingData';
+import type { RankingMetric, RankingPeriod } from '@/features/ranking/types';
+const noop = async () => null;
+export function LocalRankingPanel({ onAuthRequired }: { onAuthRequired?: () => void }) {
+  const [period, setPeriod] = useState<RankingPeriod>('today');
+  const [metric, setMetric] = useState<RankingMetric>('overall');
+  const data = useLocalRankingData({ enabled: true, period, metric, onAuthRequired });
+  return <section aria-label="本地排名"><h2 style={{fontSize:18, marginBottom:16}}>本地排名</h2><RankingPage scope="local" period={period} metric={metric} status={null} metadata={null}
+    leaderboard={data.leaderboard} leaderboardLoading={data.leaderboardLoading} leaderboardError={data.leaderboardError}
+    statusLoading={false} metadataLoading={false} statusError={null} metadataError={null} action={null} actionError={null}
+    onClearActionError={() => {}} onJoin={noop} onSync={noop} onPause={noop} onResume={noop} onExit={noop}
+    onRetryStatus={noop} onRetryMetadata={noop} onRetryLeaderboard={data.refreshLeaderboard}
+    onUpdateLocalProfile={data.updateProfile} onPeriodChange={setPeriod} onMetricChange={setMetric} /></section>;
+}
