+    <td><select form={formId} aria-label="优先认证账号" value={preferred} disabled={locked} onChange={e => setPreferred(e.target.value)}><option value="">自动分配</option>{routing.accounts.map(a => <option value={a.id} key={a.id}>{accountNames[a.id] || a.name}{a.enabled ? '' : '（停用）'}</option>)}</select></td>
+    <td className="gw-checkbox-cell"><input form={formId} aria-label="启用 Key" type="checkbox" checked={Boolean(draft.enabled)} disabled={locked} onChange={e => setDraft({ ...draft, enabled: e.target.checked })} /></td>
+    <td className="gw-checkbox-cell"><input form={formId} aria-label="超级用户" type="checkbox" checked={Boolean(draft.is_superuser)} disabled={locked} onChange={e => setDraft({ ...draft, is_superuser: e.target.checked })} /></td>
+    <td><form id={formId} className="gw-row-actions" onSubmit={save}><button type="button" disabled={locked} onClick={() => void reset()}>重置额度</button><button type="submit" className="gw-save" disabled={locked}>{busy ? '保存中…' : '保存设置'}</button></form>
+      {message && <span className={`gw-row-message${error ? ' gw-error' : ''}`} role={error ? 'alert' : 'status'}>{message}</span>}</td>
+  </tr>;
+}
+
+export function UserQuotaSettings(props: ApiKeySettingsCardProps & { onSyncKeys?: () => Promise<void> }) {
+  const [policies, setPolicies] = useState<Record<string, Policy>>({});
+  const [links, setLinks] = useState<Record<string, string>>({});
+  const [routing, setRouting] = useState<Routing | null>(null);
+  const [message, setMessage] = useState('');
+  const [search, setSearch] = useState('');
+  const [sort, setSort] = useState<{ field: SortField; ascending: boolean } | null>(null);
+  const [revision, setRevision] = useState(0);
+  const [busy, setBusy] = useState(false);
+  const aliases = useAccountAliases();
+  const bulk = async (action: 'enable' | 'disable' | 'reset') => {
+    const label = action === 'enable' ? '启用全部 Key' : action === 'disable' ? '停用全部 Key' : '重置全部用户额度';
+    if (!window.confirm(`${label}？此操作包含搜索结果之外的全部用户。`)) return;
+    setBusy(true);
+    try {
+      await gatewayAPI(action === 'reset' ? 'reset-all' : 'policies/enabled', action === 'reset' ? 'POST' : 'PUT', action === 'reset' ? undefined : { enabled: action === 'enable' });
+      setMessage(`${label}成功`); setRevision(value => value + 1);
+    } catch (e) { setMessage((e as Error).message); } finally { setBusy(false); }
+  };
+  useEffect(() => {
+    const controller = new AbortController();
+    void Promise.all([gatewayAPI<{items: Policy[]}>('summary', 'GET', undefined, controller.signal), gatewayAPI<{ items: { id: string; key_hash: string }[] }>('key-links', 'GET', undefined, controller.signal), gatewayAPI<Routing>('routing', 'GET', undefined, controller.signal)])
+      .then(([summary, keys, config]) => { setPolicies(Object.fromEntries(summary.items.map(p => [p.key_hash, p]))); setLinks(Object.fromEntries(keys.items.map(k => [k.id, k.key_hash]))); setRouting(config); })
+      .catch(e => { if (!controller.signal.aborted) setMessage(e.message); });
+    return () => controller.abort();
+  }, [revision]);
+  const users = props.apiKeys.filter(k => `${k.keyAlias} ${k.apiKey.slice(-6)}`.toLowerCase().includes(search.toLowerCase())).sort((a, b) => {
+    if (!sort) return 0;
+    const difference = sort.field === 'alias' ? a.keyAlias.localeCompare(b.keyAlias, 'zh-CN') : (policies[links[a.id]]?.[sort.field] ?? 0) - (policies[links[b.id]]?.[sort.field] ?? 0);
+    return (sort.ascending ? difference : -difference) || a.id.localeCompare(b.id);
+  });
+  const sortButton = (field: SortField, label: string) => <button className="gw-sort" type="button" aria-label={`按${label}排序`} onClick={() => setSort({ field, ascending: sort?.field === field ? !sort.ascending : field === 'alias' })}>{label}<span aria-hidden="true">{sort?.field === field ? sort.ascending ? ' ↑' : ' ↓' : ' ↕'}</span></button>;
+  const ariaSort = (fields: SortField[]) => sort && fields.includes(sort.field) ? sort.ascending ? 'ascending' as const : 'descending' as const : 'none' as const;
+  return <section className="gw-card gw-users"><div className="gw-heading"><div><h2>API Key 与用户限额</h2><p>每位用户一行，编辑后点击“保存设置”。API Key 仅显示末 6 位，点击可复制完整 Key。</p></div><span className="gw-user-count">{users.length} 位用户</span></div>
+    <div className="gw-inline gw-user-tools"><input aria-label="搜索用户" placeholder="搜索别名 / Key 末 6 位" value={search} onChange={e => setSearch(e.target.value)} /><button disabled={busy} onClick={() => void bulk('enable')}>启用全部 Key</button><button disabled={busy} onClick={() => void bulk('disable')}>停用全部 Key</button><button disabled={busy} onClick={() => void bulk('reset')}>重置全部额度</button><button disabled={busy} onClick={async () => { setBusy(true); try { await gatewayAPI('sync', 'POST'); await props.onSyncKeys?.(); setRevision(value => value + 1); setMessage('用户与价格已同步'); } catch(e) { setMessage((e as Error).message); } finally { setBusy(false); } }}>同步用户与价格</button></div>
+    {message && <p role="status">{message}</p>}
+    {aliases.error && <p role="alert">认证账号别名加载失败，暂显示已保存的账号名称。<button onClick={aliases.reload}>重试</button></p>}
+    <div className="gw-table-wrap gw-users-scroll" role="region" aria-label="用户限额表格，可横向滚动" tabIndex={0}><table className="gw-table gw-users-table">
+      <colgroup>{[68,78,174,82,170,72,null,64,64,158].map((width, index) => <col key={index} style={width === null ? undefined : { width: `${width}px` }} />)}</colgroup>
+      <thead><tr><th scope="col" aria-sort={ariaSort(['alias'])}>{sortButton('alias','别名')}</th><th scope="col">API Key</th><th scope="col" aria-sort={ariaSort(['used_usd','remaining_usd'])}><div className="gw-usage-heading">{sortButton('used_usd','周期已用')}{sortButton('remaining_usd','剩余额度')}</div></th><th scope="col" aria-sort={ariaSort(['limit_usd'])}>{sortButton('limit_usd','周期额度')}<small>USD</small></th><th scope="col">计费周期</th><th scope="col">个人并发<small>0 不限</small></th><th scope="col">优先认证账号</th><th scope="col" className="gw-checkbox-cell">启用 Key</th><th scope="col" className="gw-checkbox-cell">超级用户</th><th scope="col">操作</th></tr></thead>
+      <tbody>{users.map(item => {
+        const policy = policies[links[item.id]];
+        return policy && routing ? <UserRow key={`${item.id}-${revision}`} item={item} initial={policy} routing={routing} accountNames={aliases.names} onSaveAlias={props.onSaveAlias} disabled={busy || props.savingId === item.id} onSaved={saved => setPolicies(previous => ({ ...previous, [saved.key_hash]: saved }))} /> : <tr key={item.id}><td>{item.keyAlias || '未命名'}</td><td colSpan={9}>{message ? '限额读取失败，请同步后重试' : '正在同步用户限额…'}</td></tr>;
