@@ -0,0 +1,30 @@
+package api
+
+import (
+	"cpa-usage-keeper/internal/service"
+	"cpa-usage-keeper/internal/timeutil"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"time"
+)
+
+func registerUsageOutputSpeedRoute(router gin.IRoutes, usageProvider service.UsageProvider) {
+	router.GET("/usage/analysis/output-speed", func(c *gin.Context) {
+		filter, err := parseUsageAnalysisTimeFilterQuery(c.Request, timeutil.NormalizeStorageTime(time.Now()))
+		if err != nil {
+			writeUsageFilterParseError(c, err)
+			return
+		}
+		provider, ok := usageProvider.(service.AnalysisOutputSpeedProvider)
+		if !ok {
+			c.JSON(http.StatusServiceUnavailable, gin.H{"error": "model output speed unavailable"})
+			return
+		}
+		result, err := provider.GetAnalysisOutputSpeed(c.Request.Context(), filter)
+		if err != nil {
+			writeInternalError(c, "get model output speed failed", err)
+			return
+		}
+		c.JSON(http.StatusOK, result)
+	})
+}
