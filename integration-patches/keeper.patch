@@ -0,0 +1,32 @@
+package test
+
+import (
+	keeperapp "cpa-usage-keeper/internal/app"
+	"cpa-usage-keeper/internal/config"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestGatewayIntegrationKeepsLocalRankingWithoutCommunityRunner(t *testing.T) {
+	t.Setenv("QUOTA_GATEWAY_INTEGRATION", "1")
+	cfg := config.Config{AppPort: "invalid-port", CPABaseURL: "http://127.0.0.1:1", CPAManagementKey: "test",
+		RedisQueueIdleInterval: time.Second, MetadataSyncInterval: 30 * time.Second,
+		SQLitePath: filepath.Join(t.TempDir(), "integration.db"), RequestTimeout: time.Second, LogLevel: "error", LogFileEnabled: false}
+	application, err := keeperapp.NewWithConfig(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer application.Close()
+	if application.Ranking != nil {
+		t.Fatal("community ranking must not start in integrated mode")
+	}
+	if application.LocalRanking == nil {
+		t.Fatal("local ranking must remain available")
+	}
+	for _, route := range application.Router.Routes() {
+		if route.Path == "/api/v1/auth/sessions" || route.Path == "/api/v1/update/check" || route.Path == "/api/v1/ranking/status" {
+			t.Fatalf("removed route remains: %s", route.Path)
+		}
+	}
+}
