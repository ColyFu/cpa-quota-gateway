+++ b/internal/repository/dto/output_speed.go
@@ -0,0 +1,22 @@
+package dto
+
+import "time"
+
+// Output speed is weighted by measured generation time, never by request count.
+type ModelOutputSpeed struct {
+	Model         string     `json:"model"`
+	AverageTPS    *float64   `json:"average_tps"`
+	SampleCount   int64      `json:"sample_count"`
+	ExcludedCount int64      `json:"excluded_count"`
+	Points        []*float64 `json:"points"`
+	Samples       []int64    `json:"samples"`
+}
+
+type AnalysisOutputSpeed struct {
+	Granularity AnalysisGranularity `json:"granularity"`
+	Timezone    string              `json:"timezone"`
+	RangeStart  time.Time           `json:"range_start"`
+	RangeEnd    time.Time           `json:"range_end"`
+	Buckets     []time.Time         `json:"buckets"`
+	Models      []ModelOutputSpeed  `json:"models"`
+}
diff --git a/internal/repository/test/usage_analysis_output_speed_test.go b/internal/repository/test/usage_analysis_output_speed_test.go
new file mode 100644
index 0000000..c56c43c
--- /dev/null
+++ b/internal/repository/test/usage_analysis_output_speed_test.go
@@ -0,0 +1,97 @@
+package test
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/repository"
+	dto "cpa-usage-keeper/internal/repository/dto"
+	"math"
+	"testing"
+	"time"
+)
+
+func TestOutputSpeedExcludesWaitingAndWeightsByGenerationTime(t *testing.T) {
+	db := openTestDatabase(t)
+	start := time.Date(2026, 10, 20, 0, 0, 0, 0, time.Local)
+	end := start.Add(3 * time.Hour)
+	if err := db.Create(&[]entities.CPAAPIKey{{APIKey: "a"}, {APIKey: "b"}, {APIKey: "deleted", IsDeleted: true}}).Error; err != nil {
+		t.Fatal(err)
+	}
+	ttft := int64(9000)
+	zero := int64(0)
+	negative := int64(-1)
+	rows := []entities.UsageEvent{
+		{APIGroupKey: "a", Model: " model-a ", Timestamp: start, OutputTokens: 1000, ReasoningTokens: 400, TTFTMS: &ttft, LatencyMS: 10000},
+		{APIGroupKey: "a", Model: "model-a", Timestamp: start.Add(2 * time.Hour), OutputTokens: 1000, TTFTMS: &ttft, LatencyMS: 18000},
+		{APIGroupKey: "a", Model: "model-a", Timestamp: start, OutputTokens: 1000000, TTFTMS: &ttft, LatencyMS: 10000, Failed: true},
+		{APIGroupKey: "a", Model: "model-a", Timestamp: start, OutputTokens: 1000000, LatencyMS: 10000},
+		{APIGroupKey: "a", Model: "model-a", Timestamp: start, OutputTokens: 1000000, TTFTMS: &zero, LatencyMS: 10000},
+		{APIGroupKey: "a", Model: "model-a", Timestamp: start, OutputTokens: 1000000, TTFTMS: &negative, LatencyMS: 10000},
+		{APIGroupKey: "a", Model: "model-a", Timestamp: start, OutputTokens: 1000000, TTFTMS: &ttft, LatencyMS: 9000},
+		{APIGroupKey: "a", Model: "model-a", Timestamp: start, OutputTokens: 1000000, TTFTMS: &ttft, LatencyMS: 8000},
+		{APIGroupKey: "a", Model: "model-a", Timestamp: start, OutputTokens: 0, TTFTMS: &ttft, LatencyMS: 10000},
+		{APIGroupKey: "a", Model: "no-timing", Timestamp: start, OutputTokens: 100, LatencyMS: 10000},
+		{APIGroupKey: "b", Model: "model-b", Timestamp: start, OutputTokens: 100, TTFTMS: &ttft, LatencyMS: 10000},
+		{APIGroupKey: "deleted", Model: "deleted", Timestamp: start, OutputTokens: 100, TTFTMS: &ttft, LatencyMS: 10000},
+		{APIGroupKey: "unknown-key", Model: "unknown-key", Timestamp: start, OutputTokens: 100, TTFTMS: &ttft, LatencyMS: 10000},
+		{APIGroupKey: "a", Model: "outside", Timestamp: end, OutputTokens: 100, TTFTMS: &ttft, LatencyMS: 10000},
+	}
+	if err := db.Create(&rows).Error; err != nil {
+		t.Fatal(err)
+	}
+	result, err := repository.BuildAnalysisOutputSpeedWithFilter(db, dto.UsageQueryFilter{Range: "custom", CustomUnit: "hour", StartTime: &start, EndTime: &end, APIGroupKey: "a"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(result.Models) != 2 || len(result.Buckets) != 3 {
+		t.Fatalf("unexpected result %+v", result)
+	}
+	model := result.Models[0]
+	if model.Model != "model-a" || model.SampleCount != 2 || model.ExcludedCount != 7 || model.AverageTPS == nil || math.Abs(*model.AverageTPS-200) > 0.0001 {
+		t.Fatalf("mean must exclude 18s waiting and use total 2000 tokens / 10s generation: %+v", model)
+	}
+	if model.Points[0] == nil || *model.Points[0] != 1000 || model.Points[1] != nil || model.Points[2] == nil || math.Abs(*model.Points[2]-1000.0/9) > 0.0001 {
+		t.Fatalf("invalid curve %+v", model.Points)
+	}
+	if result.Models[1].AverageTPS != nil || result.Models[1].SampleCount != 0 {
+		t.Fatalf("missing timing must remain null %+v", result.Models[1])
+	}
+	all, err := repository.BuildAnalysisOutputSpeedWithFilter(db, dto.UsageQueryFilter{Range: "custom", CustomUnit: "hour", StartTime: &start, EndTime: &end})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(all.Models) != 3 {
+		t.Fatalf("all-key scope should include live model-b only: %+v", all.Models)
+	}
+}
+
+func TestOutputSpeedUsesLocalDayBoundariesAndRetainedHistory(t *testing.T) {
+	db := openTestDatabase(t)
+	start := time.Date(2026, 6, 1, 0, 0, 0, 0, time.Local)
+	end := start.AddDate(0, 0, 2)
+	ttft := int64(1000)
+	if err := db.Create(&entities.CPAAPIKey{APIKey: "a"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&[]entities.UsageEvent{
+		{APIGroupKey: "a", Model: "model", Timestamp: start.Add(23 * time.Hour), OutputTokens: 100, TTFTMS: &ttft, LatencyMS: 2000},
+		{APIGroupKey: "a", Model: "model", Timestamp: start.AddDate(0, 0, 1), OutputTokens: 400, TTFTMS: &ttft, LatencyMS: 3000},
+	}).Error; err != nil {
+		t.Fatal(err)
+	}
+	result, err := repository.BuildAnalysisOutputSpeedWithFilter(db, dto.UsageQueryFilter{Range: "custom", CustomUnit: "day", StartTime: &start, EndTime: &end})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Granularity != dto.AnalysisGranularityDaily || len(result.Buckets) != 2 || len(result.Models) != 1 {
+		t.Fatalf("unexpected daily result %+v", result)
+	}
+	if *result.Models[0].Points[0] != 100 || *result.Models[0].Points[1] != 200 {
+		t.Fatal("local day grouping incorrect")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := repository.BuildAnalysisOutputSpeedWithFilter(db.WithContext(ctx), dto.UsageQueryFilter{Range: "custom", CustomUnit: "day", StartTime: &start, EndTime: &end}); err == nil {
+		t.Fatal("cancelled request should not continue scanning")
+	}
+}
diff --git a/internal/repository/usage_analysis_output_speed.go b/internal/repository/usage_analysis_output_speed.go
new file mode 100644
index 0000000..3608bcc
--- /dev/null
+++ b/internal/repository/usage_analysis_output_speed.go
@@ -0,0 +1,126 @@
+package repository
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/repository/dto"
+	"cpa-usage-keeper/internal/timeutil"
+	"gorm.io/gorm"
+	"gorm.io/plugin/dbresolver"
+)
+
+// BuildAnalysisOutputSpeedWithFilter reads retained events without modifying billing or rollups.
+// Invalid timing, failed requests and zero-output requests are excluded, not assigned zero speed.
+func BuildAnalysisOutputSpeedWithFilter(db *gorm.DB, filter dto.UsageQueryFilter) (*dto.AnalysisOutputSpeed, error) {
+	if db == nil || filter.StartTime == nil || filter.EndTime == nil {
+		return nil, fmt.Errorf("output speed requires database and time bounds")
+	}
+	start, end := timeutil.NormalizeStorageTime(*filter.StartTime), timeutil.NormalizeStorageTime(*filter.EndTime)
+	if !end.After(start) {
+		return nil, fmt.Errorf("output speed end must follow start")
+	}
+	daily := end.Sub(start) > 24*time.Hour
+	if filter.Range == "custom" {
+		daily = strings.TrimSpace(filter.CustomUnit) == "day"
+	}
+	step := time.Hour
+	grain := dto.AnalysisGranularityHourly
+	if daily {
+		step, grain = 24*time.Hour, dto.AnalysisGranularityDaily
+		if timeutil.IsUsageRollingDayRange(filter.Range) {
+			start, end = analysisRollingDayWindow(start, end)
+		}
+	} else {
+		start, end = usageOverviewFullHourWindow(start, end)
+		end = analysisHourlyStatsEnd(filter, end)
+	}
+	result := &dto.AnalysisOutputSpeed{Granularity: grain, Timezone: time.Local.String(), RangeStart: start, RangeEnd: end, Buckets: []time.Time{}, Models: []dto.ModelOutputSpeed{}}
+	for cursor := start; cursor.Before(end); {
+		result.Buckets = append(result.Buckets, cursor)
+		if len(result.Buckets) > 367 {
+			return nil, fmt.Errorf("output speed range exceeds supported bucket count")
+		}
+		if daily {
+			cursor = cursor.AddDate(0, 0, 1)
+		} else {
+			cursor = cursor.Add(step)
+		}
+	}
+	if len(result.Buckets) == 0 {
+		return result, nil
+	}
+	// Hour/day boundary strings are generated from the same local calendar as Analysis.
+	// A calendar date/hour substring avoids assigning DST transitions to the wrong local day.
+	// Storage timestamps are normalized to the project timezone by the shared serializer.
+	bucketLength := 13
+	if daily {
+		bucketLength = 10
+	}
+	type bucketRow struct {
+		Model    string
+		Bucket   string
+		Requests int64
+		Samples  int64
+		Output   float64
+		Elapsed  float64
+	}
+	valid := "failed = 0 AND output_tokens > 0 AND ttft_ms > 0 AND latency_ms > ttft_ms"
+	projection := fmt.Sprintf("COALESCE(NULLIF(TRIM(model), ''), 'unknown') AS model, SUBSTR(timestamp, 1, %d) AS bucket, COUNT(*) AS requests, SUM(CASE WHEN %s THEN 1 ELSE 0 END) AS samples, SUM(CASE WHEN %s THEN 1.0 * output_tokens ELSE 0 END) AS output, SUM(CASE WHEN %s THEN 1.0 * (latency_ms - ttft_ms) ELSE 0 END) AS elapsed", bucketLength, valid, valid, valid)
+	query := db.Clauses(dbresolver.Read).Model(&entities.UsageEvent{}).
+		Joins("INNER JOIN cpa_api_keys ON cpa_api_keys.api_key = usage_events.api_group_key AND cpa_api_keys.is_deleted = ?", false).
+		Where("timestamp >= ? AND timestamp < ?", timeutil.FormatStorageTime(start), timeutil.FormatStorageTime(end))
+	if key := strings.TrimSpace(filter.APIGroupKey); key != "" {
+		query = query.Where("api_group_key = ?", key)
+	}
+	var rows []bucketRow
+	if err := query.Select(projection).Group("COALESCE(NULLIF(TRIM(model), ''), 'unknown'), bucket").Scan(&rows).Error; err != nil {
+		return nil, fmt.Errorf("load model output speed: %w", err)
+	}
+	indices := map[string]int{}
+	for i, bucket := range result.Buckets {
+		indices[bucket.Format(time.RFC3339)[:bucketLength]] = i
+	}
+	type aggregate struct {
+		model           dto.ModelOutputSpeed
+		output, elapsed float64
+	}
+	models := map[string]*aggregate{}
+	for _, row := range rows {
+		index, ok := indices[row.Bucket]
+		if !ok {
+			continue
+		}
+		item := models[row.Model]
+		if item == nil {
+			item = &aggregate{model: dto.ModelOutputSpeed{Model: row.Model, Points: make([]*float64, len(result.Buckets)), Samples: make([]int64, len(result.Buckets))}}
+			models[row.Model] = item
+		}
+		item.model.SampleCount += row.Samples
+		item.model.ExcludedCount += row.Requests - row.Samples
+		item.output += row.Output
+		item.elapsed += row.Elapsed
+		item.model.Samples[index] = row.Samples
+		if row.Samples > 0 && row.Elapsed > 0 {
+			value := row.Output * 1000 / row.Elapsed
+			item.model.Points[index] = &value
+		}
+	}
+	for _, item := range models {
+		if item.elapsed > 0 {
+			value := item.output * 1000 / item.elapsed
+			item.model.AverageTPS = &value
+		}
+		result.Models = append(result.Models, item.model)
+	}
+	sort.Slice(result.Models, func(i, j int) bool {
+		if result.Models[i].SampleCount == result.Models[j].SampleCount {
+			return result.Models[i].Model < result.Models[j].Model
+		}
+		return result.Models[i].SampleCount > result.Models[j].SampleCount
+	})
+	return result, nil
+}
