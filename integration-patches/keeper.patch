+// @vitest-environment happy-dom
+import { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { ModelOutputSpeedCard, speedCurvePath } from '../ModelOutputSpeedCard';
+import { fetchAnalysisOutputSpeed } from '@/lib/api';
+import type { AnalysisOutputSpeed } from '@/lib/types';
+vi.mock('@/lib/api',()=>({fetchAnalysisOutputSpeed:vi.fn(),ApiError:class extends Error{status=401;}}));
+globalThis.IS_REACT_ACT_ENVIRONMENT=true;
+const payload:AnalysisOutputSpeed={granularity:'hourly',timezone:'Asia/Shanghai',range_start:'2026-10-23T10:00:00+08:00',range_end:'2026-10-23T13:00:00+08:00',buckets:['2026-10-23T10:00:00+08:00','2026-10-23T11:00:00+08:00','2026-10-23T12:00:00+08:00'],models:[{model:'model-a',average_tps:200,sample_count:2,excluded_count:3,points:[1000,null,1000/9],samples:[1,0,1]},{model:'no-timing',average_tps:null,sample_count:0,excluded_count:2,points:[null,null,null],samples:[0,0,0]}]};
+describe('model output speed',()=>{
+ let container:HTMLDivElement;let root:Root;
+ beforeEach(()=>{vi.clearAllMocks();container=document.createElement('div');document.body.appendChild(container);root=createRoot(container);vi.mocked(fetchAnalysisOutputSpeed).mockResolvedValue(payload);});
+ afterEach(async()=>{await act(async()=>root.unmount());container.remove();});
+ it('shows one row per model, server-weighted mean and missing timing without inventing zero speed',async()=>{
+  await act(async()=>root.render(<ModelOutputSpeedCard request={{range:'24h'}} apiKeyId="12" />));
+  expect(container.querySelectorAll('tbody tr')).toHaveLength(2);expect(container.querySelector('tbody')?.textContent).toContain('200.0');expect(container.querySelector('tbody')?.textContent).toContain('无有效计时');
+  expect(fetchAnalysisOutputSpeed).toHaveBeenCalledWith({range:'24h'},expect.any(AbortSignal),'12');
+  expect(container.textContent).toContain('总耗时 − 首字等待');
+ });
+ it('keeps gaps in the curve and shows one sample as a dot rather than a fabricated line',()=>{
+  expect(speedCurvePath([100,null,200],200).match(/M/g)).toHaveLength(2);expect(speedCurvePath([100,null,200],200)).not.toContain('L');expect(speedCurvePath([100],200)).toBe('M150.00,28.00');
+ });
+ it('aborts the previous filter request and ignores its late response',async()=>{
+  let resolveOld!:(value:AnalysisOutputSpeed)=>void;
+  vi.mocked(fetchAnalysisOutputSpeed).mockImplementationOnce(()=>new Promise(resolve=>{resolveOld=resolve;})).mockResolvedValueOnce({...payload,models:[]});
+  await act(async()=>root.render(<ModelOutputSpeedCard request={{range:'24h'}} apiKeyId="old" />));
+  const signal=vi.mocked(fetchAnalysisOutputSpeed).mock.calls[0][1];
+  await act(async()=>root.render(<ModelOutputSpeedCard request={{range:'7d'}} apiKeyId="new" />));
+  expect(signal?.aborted).toBe(true);await act(async()=>resolveOld(payload));expect(container.textContent).toContain('暂无请求记录');expect(container.querySelectorAll('tbody tr')).toHaveLength(0);
+ });
+ it('supports independent retry and clears results for an invalid date range',async()=>{
+  vi.mocked(fetchAnalysisOutputSpeed).mockRejectedValueOnce(new Error('网络中断')).mockResolvedValueOnce(payload);
+  await act(async()=>root.render(<ModelOutputSpeedCard request={{range:'24h'}} />));expect(container.querySelector('[role=alert]')?.textContent).toContain('网络中断');
+  await act(async()=>{(container.querySelector('button') as HTMLButtonElement).click();});expect(container.querySelectorAll('tbody tr')).toHaveLength(2);
+  await act(async()=>root.render(<ModelOutputSpeedCard />));expect(container.querySelectorAll('tbody tr')).toHaveLength(0);
+ });
+ it('reloads when the page refreshes without changing its selected scope',async()=>{
+  await act(async()=>root.render(<ModelOutputSpeedCard request={{range:'24h'}} apiKeyId="12" refreshKey={1} />));
+  await act(async()=>root.render(<ModelOutputSpeedCard request={{range:'24h'}} apiKeyId="12" refreshKey={2} />));expect(fetchAnalysisOutputSpeed).toHaveBeenCalledTimes(2);
+ });
+});
