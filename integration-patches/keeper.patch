+// @vitest-environment happy-dom
+import { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { QueuePools, userHue } from './QueuePools';
+import { gatewayAPI } from './api';
+vi.mock('./api', () => ({ gatewayAPI: vi.fn() }));
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const task = { id: 'one', key_hash: 'abc', name: '小林', model: 'model-a', stage: 'personal', created_at: 10, account_id: 'account-a' };
+const state = { timestamp: 20, limit: 1, active: 0, global_queued: 0, personal_queued: 1, tasks: [task] };
+describe('live queue pools', () => {
+  let container: HTMLDivElement; let root: Root;
+  beforeEach(() => { vi.useFakeTimers(); vi.mocked(gatewayAPI).mockReset(); container = document.createElement('div'); document.body.appendChild(container); root = createRoot(container); });
+  afterEach(async () => { await act(async () => root.unmount()); container.remove(); vi.useRealTimers(); });
+  it('moves a named task between pools while retaining its user color', async () => {
+    vi.mocked(gatewayAPI).mockResolvedValueOnce(state).mockResolvedValueOnce({ ...state, timestamp: 21, active: 1, personal_queued: 0, tasks: [{ ...task, stage: 'active' }] });
+    await act(async () => root.render(<QueuePools />));
+    expect(container.querySelector('.gw-pool-personal .gw-ball')?.textContent).toBe('小林');
+    const hue = container.querySelector('.gw-ball')?.getAttribute('style');
+    await act(async () => vi.advanceTimersByTimeAsync(1000));
+    expect(container.querySelector('.gw-pool-personal .gw-ball')).toBeNull();
+    expect(container.querySelector('.gw-pool-active .gw-ball')?.getAttribute('style')).toBe(hue);
+    expect(container.querySelectorAll('.gw-pool')).toHaveLength(3);
+    expect(userHue('abc')).not.toBe(userHue('xyz'));
+  });
+  it('keeps the last snapshot visible and labels it stale after a failed poll', async () => {
+    vi.mocked(gatewayAPI).mockResolvedValueOnce(state).mockRejectedValueOnce(new Error('离线'));
+    await act(async () => root.render(<QueuePools />));
+    await act(async () => vi.advanceTimersByTimeAsync(1000));
+    expect(container.querySelector('.gw-ball')?.textContent).toBe('小林');
+    expect(container.querySelector('[role=alert]')?.textContent).toContain('最后一次');
+    expect(container.querySelector('.gw-status')?.textContent).toContain('离线');
+  });
+  it('aborts the in-flight fetch when leaving request events', async () => {
+    vi.mocked(gatewayAPI).mockImplementation(() => new Promise(() => {}));
+    await act(async () => root.render(<QueuePools />));
+    const signal = vi.mocked(gatewayAPI).mock.calls[0][3];
+    await act(async () => root.render(<div />));
+    expect(signal?.aborted).toBe(true);
+  });
+});
