+      <small>重置时间 {policy.period_ends_at ? new Date(policy.period_ends_at).toLocaleString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }) : '—'}</small></td>
