+++ b/web/src/features/gateway/QueuePools.tsx
@@ -0,0 +1,45 @@
+import { useEffect, useState, type CSSProperties } from 'react';
+import { gatewayAPI } from './api';
+import './gateway.css';
+interface Task { id: string; key_hash: string; name: string; model: string; stage: 'active' | 'global' | 'personal'; created_at: number; account_id: string }
+interface Queue { timestamp: number; limit: number; active: number; global_queued: number; personal_queued: number; tasks: Task[] }
+export const userHue = (key: string) => Array.from(key).reduce((sum, ch) => (sum * 31 + ch.charCodeAt(0)) >>> 0, 0) % 360;
+export function QueuePools() {
+  const [queue, setQueue] = useState<Queue | null>(null);
+  const [error, setError] = useState('');
+  const [user, setUser] = useState('');
+  useEffect(() => {
+    const controller = new AbortController(); let timer: ReturnType<typeof setTimeout>;
+    const poll = async () => {
+      if (!document.hidden) {
+        try { setQueue(await gatewayAPI<Queue>('queue', 'GET', undefined, controller.signal)); setError(''); }
+        catch (e) { if (!controller.signal.aborted) setError(e instanceof Error ? e.message : '更新失败'); }
+      }
+      if (!controller.signal.aborted) timer = setTimeout(poll, 1000);
+    };
+    void poll(); return () => { controller.abort(); clearTimeout(timer); };
+  }, []);
+  const users = Array.from(new Map(queue?.tasks.map(task => [task.key_hash, task.name]) ?? []).entries());
+  const stages = [['active', '执行中', '已获得执行名额'], ['global', '总排队', '等待总名额或目标账号'], ['personal', '个人排队', '等待个人并发名额']] as const;
+  return <section className="gw-card" aria-label="实时请求队列">
+    <div className="gw-heading"><div><h2>实时请求队列</h2><p>每个小球代表一个请求，同一用户使用同一颜色。</p></div>
+      <span className={error ? 'gw-status gw-error' : 'gw-status'} role="status">{error ? `连接中断 · ${error}` : queue ? `实时更新 · ${new Date(queue.timestamp * 1000).toLocaleTimeString()}` : '正在连接…'}</span></div>
+    {error && <p role="alert">显示的是最后一次成功读取的状态。</p>}
+    <div className="gw-pools">{stages.map(([stage, title, subtitle]) => {
+      const tasks = queue?.tasks.filter(t => t.stage === stage && (stage !== 'personal' || !user || t.key_hash === user)) ?? [];
+      const count = stage === 'active' ? queue?.active : stage === 'global' ? queue?.global_queued : (user ? tasks.length : queue?.personal_queued);
+      return <div className={`gw-pool gw-pool-${stage}`} key={stage}>
+        <div className="gw-pool-title"><h3>{title}</h3><strong>{count ?? '—'}{stage === 'active' && queue ? <small> / {queue.limit || '不限'}</small> : null}</strong></div>
+        <p>{subtitle}</p>
+        {stage === 'personal' && <select aria-label="个人排队用户" value={user} onChange={e => setUser(e.target.value)}><option value="">全部用户</option>{users.map(([id, name]) => <option key={id} value={id}>{name}</option>)}</select>}
+        <div className="gw-balls" aria-label={`${title}的任务`}>
+          {tasks.map(task => <div key={task.id} className="gw-ball" style={{ '--user-hue': userHue(task.key_hash) } as CSSProperties}
+            title={`${task.name}\n${task.model}\n目标账号：${task.account_id || '自动'}\n已等待/执行 ${Math.max(0, Math.round((queue?.timestamp ?? 0) - task.created_at))} 秒\n请求 ${task.id}`} tabIndex={0}>
+            <span>{task.name}</span></div>)}
+          {queue && !tasks.length && <span className="gw-pool-empty">{stage === 'active' ? '当前没有执行中的请求' : '当前没有排队请求'}</span>}
+        </div>
+      </div>;
+    })}</div>
+    <div className="gw-legend">{users.map(([id, name]) => <span key={id}><i style={{ background: `hsl(${userHue(id)} 65% 48%)` }} />{name}</span>)}</div>
+  </section>;
+}
diff --git a/web/src/features/gateway/UserQuotaSettings.tsx b/web/src/features/gateway/UserQuotaSettings.tsx
new file mode 100644
index 0000000..066953a
--- /dev/null
+++ b/web/src/features/gateway/UserQuotaSettings.tsx
@@ -0,0 +1,70 @@
+import { useEffect, useState } from 'react';
+import { ApiKeySettingsCard, type ApiKeySettingsCardProps } from '@/components/usage/ApiKeySettingsCard';
+import { gatewayAPI, type Policy, type Routing } from './api';
+import './gateway.css';
+function PolicyForm({ initial, routing, onSaved }: { initial: Policy; routing: Routing; onSaved: () => void }) {
+  const [draft, setDraft] = useState(initial);
+  const [preferred, setPreferred] = useState(routing.preferences[initial.key_hash]?.[0] ?? '');
+  const [busy, setBusy] = useState(false); const [message, setMessage] = useState('');
+  const save = async (e: React.FormEvent) => {
+    e.preventDefault(); setBusy(true); setMessage('');
+    try {
+      const saved = await gatewayAPI<Policy>('policy', 'PUT', { key_hash: draft.key_hash, limit_usd: draft.limit_usd, rpm: draft.rpm, concurrency: draft.concurrency, enabled: draft.enabled, is_superuser: draft.is_superuser, cycle_type: draft.cycle_type, cycle_days: draft.cycle_days });
+      setDraft(saved);
+      try { await gatewayAPI('preference', 'PUT', { key_hash: draft.key_hash, accounts: preferred ? [preferred] : [] }); }
+      catch (e) { setMessage(`额度已保存，优先账号保存失败：${(e as Error).message}`); return; }
+      setMessage('用户额度与优先账号已保存'); onSaved();
+    } catch (e) { setMessage((e as Error).message); } finally { setBusy(false); }
+  };
+  return <form className="gw-policy" onSubmit={save}>
+    <div className="gw-usage"><span>周期已用 <strong>${draft.used_usd.toFixed(2)}</strong></span><span>剩余 ${draft.remaining_usd.toFixed(2)}</span><progress max={Math.max(draft.limit_usd, 1)} value={draft.used_usd} /><span>周期截止 {draft.period_ends_at ? new Date(draft.period_ends_at).toLocaleString() : '—'}</span></div>
+    <div className="gw-policy-fields">
+      <label>周期额度（USD）<input type="number" min="0" step="0.01" required value={draft.limit_usd} onChange={e => setDraft({ ...draft, limit_usd: Number(e.target.value) })} /></label>
+      <label>计费周期<select value={draft.cycle_type} onChange={e => setDraft({ ...draft, cycle_type: e.target.value })}><option value="calendar_month">自然月</option><option value="fixed_days">自定义天数</option></select></label>
+      {draft.cycle_type === 'fixed_days' && <label>天数<input type="number" min="1" max="3650" step="1" required value={draft.cycle_days} onChange={e => setDraft({ ...draft, cycle_days: Number(e.target.value) })} /></label>}
+      <label>RPM（0 不限）<input type="number" min="0" step="1" required value={draft.rpm} onChange={e => setDraft({ ...draft, rpm: Number(e.target.value) })} /></label>
+      <label>个人并发（0 不限）<input type="number" min="0" step="1" required value={draft.concurrency} onChange={e => setDraft({ ...draft, concurrency: Number(e.target.value) })} /></label>
+      <label>优先认证账号<select value={preferred} onChange={e => setPreferred(e.target.value)}><option value="">自动分配</option>{routing.accounts.map(a => <option value={a.id} key={a.id}>{a.name}{a.enabled ? '' : '（停用）'}</option>)}</select></label>
+      <label className="gw-check"><input type="checkbox" checked={draft.enabled} onChange={e => setDraft({ ...draft, enabled: e.target.checked })} />启用 Key</label>
+      <label className="gw-check"><input type="checkbox" checked={draft.is_superuser} onChange={e => setDraft({ ...draft, is_superuser: e.target.checked })} />超级用户</label>
+      <button disabled={busy}>保存额度与账号</button><button type="button" disabled={busy} onClick={async () => {
+        if (!window.confirm(`重置 ${draft.alias || '此用户'} 的额度并开始新周期？历史流水将保留。`)) return;
+        setBusy(true); try { setDraft(await gatewayAPI<Policy>('policy/reset', 'POST', { key_hash: draft.key_hash })); setMessage('额度已重置'); onSaved(); } catch(e) { setMessage((e as Error).message); } finally { setBusy(false); }
+      }}>重置额度</button>
+    </div>{message && <p role="status">{message}</p>}
+  </form>;
+}
+export function UserQuotaSettings(props: ApiKeySettingsCardProps & { onSyncKeys?: () => Promise<void> }) {
+  const [policies, setPolicies] = useState<Record<string, Policy>>({});
+  const [links, setLinks] = useState<Record<string, string>>({});
+  const [routing, setRouting] = useState<Routing | null>(null);
+  const [message, setMessage] = useState('');
+  const [search, setSearch] = useState('');
+  const [sort, setSort] = useState(false);
+  const [revision, setRevision] = useState(0);
+  const [busy, setBusy] = useState(false);
+  const bulk = async (action: 'enable' | 'disable' | 'reset') => {
+    const label = action === 'enable' ? '启用全部 Key' : action === 'disable' ? '停用全部 Key' : '重置全部用户额度';
+    if (!window.confirm(`${label}？此操作包含搜索结果之外的全部用户。`)) return;
+    setBusy(true);
+    try {
+      await gatewayAPI(action === 'reset' ? 'reset-all' : 'policies/enabled', action === 'reset' ? 'POST' : 'PUT', action === 'reset' ? undefined : { enabled: action === 'enable' });
+      setMessage(`${label}成功`); setRevision(value => value + 1);
+    } catch (e) { setMessage((e as Error).message); } finally { setBusy(false); }
+  };
+  useEffect(() => {
+    const controller = new AbortController();
+    void Promise.all([gatewayAPI<{items: Policy[]}>('summary', 'GET', undefined, controller.signal), gatewayAPI<{ items: { id: string; key_hash: string }[] }>('key-links', 'GET', undefined, controller.signal), gatewayAPI<Routing>('routing', 'GET', undefined, controller.signal)])
+      .then(([summary, keys, config]) => { setPolicies(Object.fromEntries(summary.items.map(p => [p.key_hash, p]))); setLinks(Object.fromEntries(keys.items.map(k => [k.id, k.key_hash]))); setRouting(config); })
+      .catch(e => { if (!controller.signal.aborted) setMessage(e.message); });
+    return () => controller.abort();
+  }, [revision]);
+  const users = props.apiKeys.filter(k => `${k.keyAlias} ${k.displayKey}`.toLowerCase().includes(search.toLowerCase())).sort((a,b) => sort ? (policies[links[b.id]]?.used_usd ?? 0) - (policies[links[a.id]]?.used_usd ?? 0) : 0);
+  return <div className="gw-users"><div className="gw-inline"><input aria-label="搜索用户" placeholder="搜索用户 / API Key" value={search} onChange={e => setSearch(e.target.value)} /><label className="gw-check"><input type="checkbox" checked={sort} onChange={e => setSort(e.target.checked)} />按用量排序</label><button disabled={busy} onClick={() => void bulk('enable')}>启用全部 Key</button><button disabled={busy} onClick={() => void bulk('disable')}>停用全部 Key</button><button disabled={busy} onClick={() => void bulk('reset')}>重置全部额度</button><button disabled={busy} onClick={async () => { setBusy(true); try { await gatewayAPI('sync', 'POST'); await props.onSyncKeys?.(); setRevision(value => value + 1); setMessage('用户与价格已同步'); } catch(e) { setMessage((e as Error).message); } finally { setBusy(false); } }}>同步用户与价格</button></div>
+    {message && <p role="alert">{message}</p>}
+    <ApiKeySettingsCard {...props} apiKeys={users} title="API Key 与用户限额" renderPolicy={item => {
+      const policy = policies[links[item.id]];
+      return policy && routing ? <PolicyForm key={`${policy.key_hash}-${revision}`} initial={policy} routing={routing} onSaved={() => {}} /> : <p role="status">{message ? '限额读取失败' : '正在同步用户限额…'}</p>;
+    }} />
+  </div>;
+}
diff --git a/web/src/features/gateway/api.ts b/web/src/features/gateway/api.ts
new file mode 100644
index 0000000..010e3a5
--- /dev/null
+++ b/web/src/features/gateway/api.ts
@@ -0,0 +1,11 @@
+export interface Account { id: string; name: string; concurrency: number; enabled: boolean; models: string[] }
+export interface Routing { enabled: boolean; session_ttl_hours: number; overflow_threshold: number; accounts: Account[]; preferences: Record<string, string[]> }
+export interface Policy { key_hash: string; alias: string; limit_usd: number; used_usd: number; remaining_usd: number; rpm: number; concurrency: number; is_superuser: boolean; enabled: boolean; cycle_type: string; cycle_days: number; period_ends_at: string }
+export async function gatewayAPI<T>(path: string, method = 'GET', body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`/admin/${path}`, { method, credentials: 'same-origin', cache: 'no-store', signal,
+    headers: { 'Content-Type': 'application/json', ...(method !== 'GET' ? { 'X-Quota-Admin-Request': '1' } : {}) },
+    body: body === undefined ? undefined : JSON.stringify(body) });
+  const data = await response.json();
+  if (!response.ok) throw new Error(typeof data.error === 'string' ? data.error : `请求失败 (${response.status})`);
+  return data as T;
+}
