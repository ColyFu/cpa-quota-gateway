+import { useEffect, useState } from 'react';
+import { gatewayAPI, type Routing } from './api';
+import './gateway.css';
+interface Discovered { id: string; name: string; provider: string; available: boolean }
+export function AccountRouting() {
+  const [config, setConfig] = useState<Routing | null>(null);
+  const [limit, setLimit] = useState(0);
+  const [discovered, setDiscovered] = useState<Discovered[]>([]);
+  const [message, setMessage] = useState('');
+  const [busy, setBusy] = useState(false);
+  useEffect(() => {
+    const controller = new AbortController();
+    void Promise.all([gatewayAPI<Routing>('routing', 'GET', undefined, controller.signal), gatewayAPI<{ limit: number }>('concurrency', 'GET', undefined, controller.signal)]).then(([routing, state]) => { setConfig(routing); setLimit(state.limit); }).catch(e => { if (!controller.signal.aborted) setMessage(e.message); });
+    void gatewayAPI<{ accounts: Discovered[] }>('accounts', 'GET', undefined, controller.signal).then(d => setDiscovered(d.accounts)).catch(e => { if (!controller.signal.aborted) setMessage(e.message); });
+    return () => controller.abort();
+  }, []);
+  const save = async (event: React.FormEvent) => {
+    event.preventDefault(); if (!config) return; setBusy(true); setMessage('');
+    try { const saved = await gatewayAPI<Routing>('routing', 'PUT', config); setConfig(saved); setMessage('账号调度设置已保存'); }
+    catch (e) { setMessage(e instanceof Error ? e.message : '保存失败'); } finally { setBusy(false); }
+  };
+  return <section className="gw-card"><div className="gw-heading"><div><h2>并发与账号调度</h2><p>总并发控制整个网关；账号并发控制单个认证文件。</p></div></div>
+    {message && <p role="status" className="gw-message">{message}</p>}
+    <form className="gw-inline" onSubmit={async e => { e.preventDefault(); setBusy(true); try { await gatewayAPI('concurrency', 'PUT', { global_limit: limit }); setMessage('总并发已保存'); } catch(e) { setMessage((e as Error).message); } finally { setBusy(false); } }}>
+      <label>总并发上限<input type="number" min="0" step="1" required value={limit} onChange={e => setLimit(Number(e.target.value))} /></label><button disabled={busy || !config}>保存总并发</button><span>0 表示不限制</span>
+    </form>
+    {config && <form onSubmit={save}>
+      <div className="gw-inline">
+        <label className="gw-check"><input type="checkbox" checked={config.enabled} onChange={e => setConfig({ ...config, enabled: e.target.checked })} />启用账号调度</label>
+        <label>会话保持（小时）<input type="number" min="0.1" max="720" step="0.1" required value={config.session_ttl_hours} onChange={e => setConfig({ ...config, session_ttl_hours: Number(e.target.value) })} /></label>
+        <label>账号溢出阈值（排队数）<input type="number" min="0" step="1" required value={config.overflow_threshold} onChange={e => setConfig({ ...config, overflow_threshold: Number(e.target.value) })} /></label>
+      </div>
+      <p className="gw-help">同一用户的同一 session 从最近一次请求起保持绑定。新会话优先使用用户指定账号；账号满载且排队达到阈值时，才分配到有空位的账号。已有会话保持原账号，账号不可用时重新选择。</p>
+      <div className="gw-table-wrap"><table className="gw-table"><thead><tr><th>认证文件</th><th>参与调度</th><th>账号并发</th><th>模型限制（留空由 CPA 判断）</th></tr></thead><tbody>{config.accounts.map((account, index) => <tr key={account.id}>
+        <td><strong>{account.name}</strong><small>{account.id}</small></td>
+        <td><input aria-label={`${account.name} 参与调度`} type="checkbox" checked={account.enabled} onChange={e => setConfig({ ...config, accounts: config.accounts.map((a, i) => i === index ? { ...a, enabled: e.target.checked } : a) })} /></td>
+        <td><input aria-label={`${account.name} 账号并发`} type="number" min="1" step="1" required value={account.concurrency} onChange={e => setConfig({ ...config, accounts: config.accounts.map((a, i) => i === index ? { ...a, concurrency: Number(e.target.value) } : a) })} /></td>
+        <td><input aria-label={`${account.name} 模型限制`} defaultValue={account.models.join(', ')} onBlur={e => setConfig({ ...config, accounts: config.accounts.map((a, i) => i === index ? { ...a, models: e.target.value.split(',').map(x => x.trim()).filter(Boolean) } : a) })} /></td>
+      </tr>)}</tbody></table></div>
+      <div className="gw-inline"><label>添加认证文件<select value="" onChange={e => { const a = discovered.find(x => x.id === e.target.value); if (a) setConfig({ ...config, accounts: [...config.accounts, { id: a.id, name: a.name, enabled: a.available, concurrency: 1, models: [] }] }); }}><option value="">请选择账号</option>{discovered.filter(a => !config.accounts.some(c => c.id === a.id)).map(a => <option key={a.id} value={a.id}>{a.name} · {a.provider}{a.available ? '' : '（不可用）'}</option>)}</select></label><button disabled={busy}>保存账号调度</button></div>
+    </form>}
+  </section>;
+}
