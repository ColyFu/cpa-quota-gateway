@@ -0,0 +1,44 @@
+package test
+
+import (
+	"context"
+	. "cpa-usage-keeper/internal/api"
+	repodto "cpa-usage-keeper/internal/repository/dto"
+	dto "cpa-usage-keeper/internal/service/dto"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+type outputSpeedStub struct {
+	analysisSplitStub
+	filter dto.UsageFilter
+	calls  int
+}
+
+func (s *outputSpeedStub) GetAnalysisOutputSpeed(_ context.Context, filter dto.UsageFilter) (*repodto.AnalysisOutputSpeed, error) {
+	s.filter = filter
+	s.calls++
+	return &repodto.AnalysisOutputSpeed{Models: []repodto.ModelOutputSpeed{}}, nil
+}
+func TestOutputSpeedRouteSharesAnalysisScopeAndAuthentication(t *testing.T) {
+	provider := &outputSpeedStub{}
+	router := NewRouter(nil, nil, provider, nil, AuthConfig{}, nil, "")
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/api/v1/usage/analysis/output-speed?range=24h&api_key_id=12", nil))
+	if response.Code != 200 || !strings.Contains(response.Body.String(), `"models":[]`) || provider.filter.APIKeyID != "12" || provider.filter.StartTime == nil || provider.calls != 1 {
+		t.Fatalf("invalid scope/status: %d %+v %s", response.Code, provider.filter, response.Body.String())
+	}
+	response = httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/api/v1/usage/analysis/output-speed?range=invalid", nil))
+	if response.Code != 400 || provider.calls != 1 {
+		t.Fatalf("invalid range reached provider: %d", response.Code)
+	}
+	router = NewRouter(nil, nil, provider, nil, AuthConfig{Enabled: true}, nil, "")
+	response = httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/api/v1/usage/analysis/output-speed?range=24h", nil))
+	if response.Code != 401 || provider.calls != 1 {
+		t.Fatalf("unauthenticated request reached provider: %d", response.Code)
+	}
+}
