+import { useEffect, useState } from 'react';
+import { copyApiKeyToClipboard, type ApiKeySettingsCardProps } from '@/components/usage/ApiKeySettingsCard';
+import type { CpaApiKeySettingsItem } from '@/lib/types';
+import { gatewayAPI, type Policy, type Routing } from './api';
+import { useAccountAliases } from './useAccountAliases';
+import './gateway.css';
+
+type SortField = 'alias' | 'used_usd' | 'remaining_usd' | 'limit_usd';
+const money = (value: number) => `$${value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
+
+function UserRow({ item, initial, routing, accountNames, onSaveAlias, onSaved, disabled }: {
+  item: CpaApiKeySettingsItem; initial: Policy; routing: Routing; accountNames: Record<string, string>;
+  onSaveAlias: ApiKeySettingsCardProps['onSaveAlias']; onSaved: (policy: Policy) => void; disabled: boolean;
+}) {
+  const [draft, setDraft] = useState(initial);
+  const [policy, setPolicy] = useState(initial);
+  const [alias, setAlias] = useState(item.keyAlias);
+  const [savedAlias, setSavedAlias] = useState(item.keyAlias);
+  const [preferred, setPreferred] = useState(routing.preferences[initial.key_hash]?.[0] ?? '');
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState('');
+  const [error, setError] = useState(false);
+  const [copied, setCopied] = useState(false);
+  const formId = `quota-user-${item.id}`;
+  const tail = item.apiKey ? item.apiKey.slice(-6) : '不可用';
+  const locked = busy || disabled;
+  const percent = policy.limit_usd > 0 ? Math.min(100, Math.max(0, policy.used_usd / policy.limit_usd * 100)) : 100;
+  useEffect(() => {
+    if (!copied) return;
+    const timer = setTimeout(() => setCopied(false), 1600);
+    return () => clearTimeout(timer);
+  }, [copied]);
+  const save = async (event: React.FormEvent) => {
+    event.preventDefault(); setBusy(true); setMessage(''); setError(false);
+    const completed: string[] = [];
+    try {
+      if (alias.trim() !== savedAlias.trim()) {
+        await onSaveAlias(item.id, alias.trim()); setAlias(alias.trim()); setSavedAlias(alias.trim()); completed.push('别名');
+      }
+      const saved = await gatewayAPI<Policy>('policy', 'PUT', {
+        key_hash: draft.key_hash, limit_usd: draft.limit_usd, concurrency: draft.concurrency,
+        enabled: draft.enabled, is_superuser: draft.is_superuser, cycle_type: draft.cycle_type, cycle_days: draft.cycle_days,
+      });
+      setDraft(saved); setPolicy(saved); onSaved(saved); completed.push('额度设置');
+      await gatewayAPI('preference', 'PUT', { key_hash: draft.key_hash, accounts: preferred ? [preferred] : [] });
+      setMessage('已保存');
+    } catch (e) {
+      setError(true); setMessage(`${completed.length ? `${completed.join('、')}已保存；其余保存失败：` : ''}${(e as Error).message}`);
+    } finally { setBusy(false); }
+  };
+  const reset = async () => {
+    if (!window.confirm(`重置 ${savedAlias || tail} 的额度并开始新周期？历史流水将保留。`)) return;
+    setBusy(true); setMessage(''); setError(false);
+    try {
+      const saved = await gatewayAPI<Policy>('policy/reset', 'POST', { key_hash: policy.key_hash });
+      setPolicy(saved); onSaved(saved); setMessage('额度已重置');
+    } catch (e) { setError(true); setMessage((e as Error).message); } finally { setBusy(false); }
+  };
+  return <tr className="gw-user-row">
+    <td><input form={formId} aria-label="用户别名" maxLength={50} placeholder="填写别名" value={alias} disabled={locked} onChange={e => setAlias(e.target.value)} /></td>
+    <td><button type="button" className="gw-key-copy" disabled={!item.apiKey} title="点击复制完整 API Key" aria-label={`复制 API Key，末尾 ${tail}`} onClick={async () => {
+      try { await copyApiKeyToClipboard(item.apiKey); setCopied(true); }
+      catch { setError(true); setMessage('复制失败，请重试'); }
+    }}><code>{tail}</code><span>{copied ? '已复制' : '点击复制'}</span></button></td>
+    <td className="gw-user-usage"><div><span>已用 <strong>{money(policy.used_usd)}</strong></span><span>剩余 <strong>{money(policy.remaining_usd)}</strong></span></div>
+      <progress aria-label="周期额度使用进度" max={100} value={percent} className={percent >= 90 ? 'gw-progress-warning' : ''} />
+      <small>重置 {policy.period_ends_at ? new Date(policy.period_ends_at).toLocaleString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }) : '—'}</small></td>
+    <td><input form={formId} aria-label="周期额度（USD）" type="number" min="0" step="0.01" required value={draft.limit_usd} disabled={locked} onChange={e => setDraft({ ...draft, limit_usd: Number(e.target.value) })} /></td>
+    <td><div className="gw-cycle"><select form={formId} aria-label="计费周期" value={draft.cycle_type} disabled={locked} onChange={e => setDraft({ ...draft, cycle_type: e.target.value })}><option value="calendar_month">自然月</option><option value="fixed_days">自定义天数</option></select>
+      {draft.cycle_type === 'fixed_days' && <label><input form={formId} aria-label="计费天数" type="number" min="1" max="3650" step="1" required value={draft.cycle_days} disabled={locked} onChange={e => setDraft({ ...draft, cycle_days: Number(e.target.value) })} /><span>天</span></label>}</div></td>
+    <td><input form={formId} aria-label="个人并发（0 不限）" title="0 表示只受总并发限制" type="number" min="0" step="1" required value={draft.concurrency} disabled={locked} onChange={e => setDraft({ ...draft, concurrency: Number(e.target.value) })} /></td>
+    <td><select form={formId} aria-label="优先认证账号" value={preferred} disabled={locked} onChange={e => setPreferred(e.target.value)}><option value="">自动分配</option>{routing.accounts.map(a => <option value={a.id} key={a.id}>{accountNames[a.id] || a.name}{a.enabled ? '' : '（停用）'}</option>)}</select></td>
+    <td className="gw-checkbox-cell"><input form={formId} aria-label="启用 Key" type="checkbox" checked={Boolean(draft.enabled)} disabled={locked} onChange={e => setDraft({ ...draft, enabled: e.target.checked })} /></td>
+    <td className="gw-checkbox-cell"><input form={formId} aria-label="超级用户" type="checkbox" checked={Boolean(draft.is_superuser)} disabled={locked} onChange={e => setDraft({ ...draft, is_superuser: e.target.checked })} /></td>
+    <td><form id={formId} className="gw-row-actions" onSubmit={save}><button type="button" disabled={locked} onClick={() => void reset()}>重置额度</button><button type="submit" className="gw-save" disabled={locked}>{busy ? '保存中…' : '保存设置'}</button></form>
+      {message && <span className={`gw-row-message${error ? ' gw-error' : ''}`} role={error ? 'alert' : 'status'}>{message}</span>}</td>
+  </tr>;
+}
+
+export function UserQuotaSettings(props: ApiKeySettingsCardProps & { onSyncKeys?: () => Promise<void> }) {
+  const [policies, setPolicies] = useState<Record<string, Policy>>({});
+  const [links, setLinks] = useState<Record<string, string>>({});
+  const [routing, setRouting] = useState<Routing | null>(null);
+  const [message, setMessage] = useState('');
+  const [search, setSearch] = useState('');
+  const [sort, setSort] = useState<{ field: SortField; ascending: boolean } | null>(null);
+  const [revision, setRevision] = useState(0);
+  const [busy, setBusy] = useState(false);
+  const aliases = useAccountAliases();
+  const bulk = async (action: 'enable' | 'disable' | 'reset') => {
+    const label = action === 'enable' ? '启用全部 Key' : action === 'disable' ? '停用全部 Key' : '重置全部用户额度';
+    if (!window.confirm(`${label}？此操作包含搜索结果之外的全部用户。`)) return;
+    setBusy(true);
+    try {
+      await gatewayAPI(action === 'reset' ? 'reset-all' : 'policies/enabled', action === 'reset' ? 'POST' : 'PUT', action === 'reset' ? undefined : { enabled: action === 'enable' });
+      setMessage(`${label}成功`); setRevision(value => value + 1);
+    } catch (e) { setMessage((e as Error).message); } finally { setBusy(false); }
+  };
+  useEffect(() => {
+    const controller = new AbortController();
+    void Promise.all([gatewayAPI<{items: Policy[]}>('summary', 'GET', undefined, controller.signal), gatewayAPI<{ items: { id: string; key_hash: string }[] }>('key-links', 'GET', undefined, controller.signal), gatewayAPI<Routing>('routing', 'GET', undefined, controller.signal)])
+      .then(([summary, keys, config]) => { setPolicies(Object.fromEntries(summary.items.map(p => [p.key_hash, p]))); setLinks(Object.fromEntries(keys.items.map(k => [k.id, k.key_hash]))); setRouting(config); })
+      .catch(e => { if (!controller.signal.aborted) setMessage(e.message); });
+    return () => controller.abort();
+  }, [revision]);
+  const users = props.apiKeys.filter(k => `${k.keyAlias} ${k.apiKey.slice(-6)}`.toLowerCase().includes(search.toLowerCase())).sort((a, b) => {
+    if (!sort) return 0;
+    const difference = sort.field === 'alias' ? a.keyAlias.localeCompare(b.keyAlias, 'zh-CN') : (policies[links[a.id]]?.[sort.field] ?? 0) - (policies[links[b.id]]?.[sort.field] ?? 0);
+    return (sort.ascending ? difference : -difference) || a.id.localeCompare(b.id);
+  });
+  const sortButton = (field: SortField, label: string) => <button className="gw-sort" type="button" aria-label={`按${label}排序`} onClick={() => setSort({ field, ascending: sort?.field === field ? !sort.ascending : field === 'alias' })}>{label}<span aria-hidden="true">{sort?.field === field ? sort.ascending ? ' ↑' : ' ↓' : ' ↕'}</span></button>;
+  const ariaSort = (fields: SortField[]) => sort && fields.includes(sort.field) ? sort.ascending ? 'ascending' as const : 'descending' as const : 'none' as const;
+  return <section className="gw-card gw-users"><div className="gw-heading"><div><h2>API Key 与用户限额</h2><p>每位用户一行，编辑后点击“保存设置”。API Key 仅显示末 6 位，点击可复制完整 Key。</p></div><span className="gw-user-count">{users.length} 位用户</span></div>
